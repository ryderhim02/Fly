World_Events :: class : Component {
    @ao_serialize halloween_decor: Entity;
    active_event: int = -1;
    event_until: float;
    next_event: float;
    event_number: int;
    luck: float = 1;
    mutation: int = 1;
    harvest: int;
    harvest_rounds: int;
    contributors: [..]string;
    snap_until: float;
    rng: u64;
    ao_start :: method() {
        rng = rng_root_seed();
        next_event = get_time() + 90;
        if #alive(halloween_decor) { halloween_decor.set_local_enabled(false); }
    }
    ao_update :: method(dt: float) {
        if active_event >= 0 && get_time() >= event_until { end_world_event(this); }
        if active_event < 0 && get_time() >= next_event && get_time() >= snap_until {
            kind := event_number % 3 == 0 ? 2 : (event_number % 3 - 1);
            event_number += 1;
            begin_world_event(this, kind, kind == 1 ? 3.0 : 2.0, kind + 1);
        }
    }
    add_harvest :: method(p: Player) {
        if active_event != 2 { return; }
        id := p.get_user_id();
        found := false;
        for user: contributors { if user == id { found = true; } }
        if !found { contributors.append(id); }
        harvest += 1;
        if harvest >= 40 {
            harvest = 0;
            harvest_rounds += 1;
            for player: component_iterator(Player) {
                for user: contributors {
                    if player.get_user_id() == user {
                        Economy.deposit_currency(player, "Candy", 50);
                        reward_player(player, 500, "Community harvest! +50 candy");
                    }
                }
            }
            contributors.clear();
            burst_fx({64, 2}, {0.9, 0.35, 1, 1}, true);
        }
    }
}
get_world_events :: proc() -> World_Events {
    for world: component_iterator(World_Events) { return world; }
    return null;
}
halloween_active :: proc() -> bool { w := get_world_events(); return #alive(w) && w.active_event == 2; }
EVENT_NAMES: [3]string = {"Golden Tide", "Aurora Bloom", "Halloween Event 2.0"};
begin_world_event :: proc(w: World_Events, kind: int, luck: float, mutation: int) {
    if kind != 2 { for p: component_iterator(Player) { if p.entity.world_position.x > 50 { teleport_harbor(p); } } }
    w.active_event = clamp(kind, 0, 2);
    w.luck = clamp(luck, 1.0, 8.0);
    w.mutation = clamp(mutation, 1, 5);
    w.event_until = get_time() + 120;
    w.harvest = 0; w.harvest_rounds = 0; w.contributors.clear();
    if #alive(w.halloween_decor) { w.halloween_decor.set_local_enabled(kind == 2); }
    for p: component_iterator(Player) { play_personal(p, "use_magic_20a0f2.wav", 0.3); }
}
end_world_event :: proc(w: World_Events) {
    w.active_event = -1; w.luck = 1;
    w.next_event = get_time() + 180;
    if #alive(w.halloween_decor) { w.halloween_decor.set_local_enabled(false); }
    for p: component_iterator(Player) { if p.entity.world_position.x > 50 { teleport_harbor(p); feedback(p, "The event ended. Your candy and catches are safe."); } }
}
start_snap :: proc(p: Player) {
    if !can_admin(p) { return; }
    w := get_world_events();
    if !#alive(w) { return; }
    if get_time() < w.snap_until { feedback(p, "Snap is already walking across the harbor."); return; }
    w.snap_until = get_time() + 15;
    for giant: 0..<2 {
        e := Scene.create_entity(); e.set_name("Schleem_Snap_Replica");
        e.set_world_position({-10 - giant.(float) * 2, -0.8});
        scale := giant == 1 ? 3.6 : 1.15;
        e.set_local_scale({scale, scale});
        e.add_component(Snap_Replica, on_before_start=proc(r: Snap_Replica) { r.owner_id = p.get_user_id(); r.owner_name = p.get_username(); r.giant = giant == 1; });
        effect := new(Snap_March_Effect);
        effect.giant = giant == 1;
        effect.start_position = e.world_position;
        set_active_effect(e, effect);
    }
    set_active_effect(p.entity, new(Admin_Snap_Performer));
    p.menu = 0;
}
snap :: proc(player: Player) { start_snap(player); } @chat_command @owner_or_editor
halloween :: proc(player: Player) {
    if !can_admin(player) { return; }
    w := get_world_events(); if #alive(w) { begin_world_event(w, 2, 2, 3); }
} @chat_command @owner_or_editor



