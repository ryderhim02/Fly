// Bounded, repeatable load. Synthetic anglers never change real player progress.
Perf_Load :: class : Component {
    spawned: [..]Entity;
    expires_at: float;
    simulated_players: int = 8;
    next_cast: float;
    // Fixed anglers and static spots: resolve once, not at every cast.
    // These are disposable query caches, not cross-entity ownership.
    targets: [..]Fishing_Spot;
    targets_ready: bool;
    query_count: int;
    cast_count: int;
    ao_update :: method(dt: float) {
        now := get_time();
        if now >= expires_at {
            this.clear();
            return;
        }
        if now < next_cast return;
        next_cast = now + 0.8;
        if !targets_ready {
            targets.reserve(simulated_players);
            for i: 0..<simulated_players {
                targets.append(this.resolve_target(i));
            }
            targets_ready = true;
        }
        for target, i: targets {
            if target != null && !#alive(target) {
                target = this.resolve_target(i);
                targets[i] = target;
            }
            if #alive(target) && target.is_perf_fixture && now >= target.cooldown_until {
                target.cooldown_until = now + 2.5;
                cast_count += 1;
            }
        }
    }
    resolve_target :: method(index: int) -> Fishing_Spot {
        position := v2{(index % 16).(float) * 1.25 - 9.375, 2.0};
        spot, found := Scene.get_closest_component_in_range(position, 1.8, Fishing_Spot);
        query_count += 1;
        if found return spot;
        return null;
    }
    clear :: method() {
        for item: spawned { if #alive(item) item.destroy(); }
        spawned.clear();
        targets.clear();
        entity.destroy();
    }
}

perf_test :: proc(player: Player, spots: int = 256, seconds: float = 120, anglers: int = 32) {
    for load: component_iterator(Perf_Load) { load.clear(); }
    if spots <= 0 {
        Notifier.notify(player, "Performance load cleared.");
        return;
    }
    count := clamp(spots, 1, 256);
    root := Scene.create_entity();
    root.set_name("Performance_Load");
    load := root.add_component(Perf_Load, on_before_start=proc(p: Perf_Load) {
        p.simulated_players = clamp(anglers, 0, 32);
        p.expires_at = get_time() + clamp(seconds, 10.0, 600.0);
    });
    load.spawned.reserve(count);
    for i: 0..<count {
        x := (i % 16).(float) * 1.25 - 9.375;
        y := (i / 16).(float) * 1.25 + 2.0;
        load.spawned.append(spawn_fishing_spot({x, y}, true));
    }
    Notifier.notify(player, `Performance load: {count} spots, {load.simulated_players} synthetic anglers. /perf_test 0 clears it.`);
} @chat_command @owner_or_editor

