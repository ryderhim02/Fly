import "core:ao"

TACO_EVENT_DURATION :: 60.0;
TACO_MUTATION_CHANCE_PERCENT :: 1;

taco_event_system: Taco_Event;

Taco_Rain_Drop :: class : Component {
    fall_speed: float;

    ao_start :: method() {
        fall_speed = 8.0;
    }

    ao_update :: method(dt: float) {
        entity.add_local_position(v2{0, -fall_speed * dt});
        if entity.local_position.y < -8 {
            entity.destroy();
            return;
        }
    }
}

Taco_Mutation_Catch :: class : Component {
    expires_at: float;

    ao_start :: method() {
        expires_at = get_time() + 2.5;
    }

    ao_update :: method(dt: float) {
        entity.add_local_position(v2{0, 1.4 * dt});
        if get_time() >= expires_at {
            entity.destroy();
            return;
        }
    }
}

Taco_Event :: class : Component {
    active_until: float @ao_serialize;
    next_rain_time: float @ao_serialize;
    rng: u64 @ao_serialize;

    ao_start :: method() {
        active_until = 0;
        next_rain_time = 0;
        rng = rng_root_seed();
    }

    is_active :: method() -> bool {
        return get_time() < active_until;
    }

    start_event :: method() {
        active_until = get_time() + TACO_EVENT_DURATION;
        next_rain_time = get_time();
    }

    ao_update :: method(dt: float) {
        if !is_active() || get_time() < next_rain_time {
            return;
        }

        next_rain_time = get_time() + 0.16;
        spawn_rain_taco(rng_range_float(ref rng, -12, 12), rng_range_float(ref rng, 8, 13));
    }
}

spawn_rain_taco :: proc(x: float, y: float) {
    taco := Scene.create_entity();
    taco.set_local_position(v2{x, y});
    taco.set_local_scale(v2{0.75, 0.75});
    taco.set_local_rotation(rng_range_float(ref taco_event_system.rng, -25, 25));

    sprite := taco.add_component(Sprite_Renderer);
    sprite.set_texture(get_asset(Texture_Asset, "event/taco.png"));
    sprite.layer = 5;
    taco.add_component(Taco_Rain_Drop);
}

spawn_taco_mutation_fish :: proc(position: v2) {
    fish := Scene.create_entity();
    fish.set_local_position(position + v2{0, 1.0});
    fish.set_local_scale(v2{1.25, 1.25});

    fish_sprite := fish.add_component(Sprite_Renderer);
    fish_sprite.set_texture(get_asset(Texture_Asset, "event/fish.png"));
    fish_sprite.layer = 6;

    taco := Scene.create_entity();
    taco.set_parent(fish, false);
    taco.set_local_position(v2{-0.25, 0.68});
    taco.set_local_scale(v2{0.48, 0.48});
    taco_sprite := taco.add_component(Sprite_Renderer);
    taco_sprite.set_texture(get_asset(Texture_Asset, "event/taco.png"));
    taco_sprite.layer = 7;

    fish.add_component(Taco_Mutation_Catch);
}

taco_event :: proc(player: Player) {
    taco_event_system.start_event();
    Notifier.notify("Taco event started! Taco rain is falling for one minute.");
} @chat_command @owner

// Manual shore fishing and boat travel.
Boat_Travel :: class : Component {
    destination: v2;

    ao_start :: method() {
        destination = v2{0, -5};
    }

    can_use :: method(player: Player) -> bool {
        return true;
    }

    on_interact :: method(player: Player) {
        player.entity.set_local_position(destination);
        player.entity.mark_teleported();
    }
}

spawn_boat :: proc(position: v2) {
    boat_entity := Scene.create_entity();
    boat_entity.set_local_position(position);

    marker := boat_entity.add_component(Light);
    marker.color = v4{0.1, 0.45, 1.0, 1.0};
    marker.intensity = 2.0;
    marker.radii = v2{1.5, 1.0};

    listener := boat_entity.add_component(Boat_Travel);
    interactable := boat_entity.add_component(Interactable);
    interactable.radius = 2.0;
    interactable.required_hold_time = 0.8;
    interactable.set_text("Sail");
    interactable.set_hold_text("Board Boat");
    interactable.set_subtitle("Travel to the far shore");
    interactable.set_listener(listener);
}
Fishing_Spot :: class : Component {
    cooldown_until: float;
    rng: u64;

    ao_start :: method() {
        cooldown_until = 0;
        rng = rng_root_seed();
    }

    can_use :: method(player: Player) -> bool {
        return get_time() >= cooldown_until;
    }

    on_interact :: method(player: Player) {
        // Set the shared state first so prediction and reconciliation agree.
        cooldown_until = get_time() + 2.5;
        player.fish_caught += 1;

        if taco_event_system.is_active() && rng_range_int(ref rng, 1, 100) <= TACO_MUTATION_CHANCE_PERCENT {
            player.taco_mutation_fish_caught += 1;
            spawn_taco_mutation_fish(player.entity.world_position);
            Notifier.notify(player, "Taco Mutation caught!");
        }
    }
}

spawn_fishing_spot :: proc(position: v2) {
    spot_entity := Scene.create_entity();
    spot_entity.set_local_position(position);

    // A small glow makes each manual fishing point easy to locate in-world.
    glow := spot_entity.add_component(Light);
    glow.color = v4{0.15, 0.65, 1.0, 1.0};
    glow.intensity = 1.5;
    glow.radii = v2{1.2, 1.2};

    listener := spot_entity.add_component(Fishing_Spot);
    interactable := spot_entity.add_component(Interactable);
    interactable.radius = 1.8;
    interactable.required_hold_time = 0.8;
    interactable.set_text("Fish");
    interactable.set_hold_text("Cast Line");
    interactable.set_subtitle("Fishing Spot");
    interactable.set_listener(listener);
}

// Game wide systems
ao_before_scene_load :: proc() {
    // Called before the scene is loaded (economy registration etc...)
}

ao_start :: proc() {
    event_entity := Scene.create_entity();
    taco_event_system = event_entity.add_component(Taco_Event);
    spawn_boat(v2{0, 5});
    // Shoreline fishing positions; players walk up and hold interact.
    spawn_fishing_spot(v2{-7, 2});
    spawn_fishing_spot(v2{-2, 2});
    spawn_fishing_spot(v2{3, 2});
    spawn_fishing_spot(v2{8, 2});
}

ao_update :: proc(dt: float) {

}

ao_late_update :: proc(dt: float) {

}

// Per player state
Player :: class : Player_Base {
    fish_caught: s32 @ao_serialize;
    taco_mutation_fish_caught: s32 @ao_serialize;

    ao_start :: method() {
        // Basically on awake/join
    }

    ao_update :: method(dt: float) {
        // Every frame
    }

    ao_late_update :: method(dt: float) {
        // After physics runs, all UI must be rendered from here
    }

    ao_end :: method() {
        // On destroy
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Global ability callback for example don't allow use when dead
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Global interactable callback
        return true;
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
    }
}
