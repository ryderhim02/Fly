import "core:ao"
import "game"

ao_before_scene_load :: proc() {
    Scene.set_player_inventory_capacity(16);
    Scene.set_auto_save_player_inventory(true);
    Economy.register_currency("Coins", get_asset(Texture_Asset, "coin_5faf13.png"));
    register_fishes();
    fishing_intro = Tutorial.define("harbor_intro", .{
        Tutorial_Step.event("catch", "harbor:catch", count=1, point_to=Tutorial_Target.world({-6,2}), text="Hold Fish at the pier."),
        Tutorial_Step.click("sell", Tutorial_Target.ui(get_asset(UIDoc_Asset,"UI/harbor.uidoc"), "sell"), text="Sell your catch."),
    });
}

ao_start :: proc() {
    for x: 0..<4 {
        e := Scene.create_entity();
        e.set_name(`Fishing_{x}`);
        e.set_local_position({-6 + x.(float) * 4, 2});
        e.add_component(Fishing_Spot);
    }
}
