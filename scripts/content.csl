// Ten-thousandths of a zzz per second. Every baseline, including Juice WRLD's 1 zzz, is debuffed exactly 3%.
BRAIN_BASE: [6]int = {100, 300, 700, 1600, 4000, 10000};
RESEARCH_NAMES: [4]string = {"Baitcraft", "Swift Reel", "Merchant's Eye", "Mutation Lantern"};
RESEARCH_DESC: [4]string = {"+12% rare-fish luck per rank", "Shorter personal casting cooldown", "+8% fish sale value per rank", "+2% mutation chance per rank"};
fish_definitions: [..]Item_Definition;
harbor_lesson: Tutorial;

compact :: proc(value: int) -> string {
    if value >= 1000000 { return `{format_float(value.(float) / 1000000, decimals=2)}m`; }
    if value >= 1000 { return `{format_float(value.(float) / 1000, decimals=1)}k`; }
    return `{value}`;
}
owned_species :: proc(p: Player) -> int {
    total := 0;
    for i: 0..<12 { if p.discoveries[i] > 0 { total += 1; } }
    return total;
}
variant_count :: proc(p: Player) -> int {
    total := 0;
    for bits: p.discoveries { for j: 0..<6 { if (bits & (1 << j)) != 0 { total += 1; } } }
    return total;
}
zzz_rate :: proc(p: Player) -> int {
    rate := 0;
    for v, i: BRAIN_CATCHES { if p.fish_caught >= v { rate += BRAIN_BASE[i] * 97 / 100; } }
    return rate;
}
play_personal :: proc(p: Player, path: string, volume: float = 0.4) {
    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = p.entity.id;
    desc.specific_to_player = p;
    desc.volume = volume;
    desc.speed_perturb = 0.08;
    SFX.play(get_asset(SFX_Asset, path), desc);
}
reward_player :: proc(p: Player, amount: int, message: string) {
    if amount > 0 { Economy.deposit_currency(p, "Coins", amount); }
    p.reward_message = message;
    p.reward_until = get_time() + 3.0;
    play_personal(p, "reward_682e78.wav", 0.25);
}
teleport_harbor :: proc(p: Player) {
    p.entity.set_world_position({0, -0.5});
    p.entity.mark_teleported();
    p.agent.velocity = {0, 0};
}

can_admin :: proc(p: Player) -> bool {
    // Editor sessions use a test account; published games always require native owner/editor rights.
    return p.is_owner_or_editor() || Game.is_launched_from_editor();
}

